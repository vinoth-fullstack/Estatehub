# URL of the EstateHub API as seen from the BROWSER
NEXT_PUBLIC_API_URL=http://localhost:4000

# URL of the API as seen from the Next.js SERVER (server components, sitemap).
# Usually the same; differs in Docker/Kubernetes where the server uses an internal hostname.
API_URL=http://localhost:4000

# Public URL of this website. Used for canonical links, Open Graph tags and the sitemap.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
